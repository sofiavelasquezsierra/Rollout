# Server-only. Never prefix with NEXT_PUBLIC_. Without it, Rollout runs on the
# scripted policy and the cached example runs.
ANTHROPIC_API_KEY=

# Optional model overrides
ROLLOUT_AGENT_MODEL=claude-haiku-5-5
ROLLOUT_EVALUATOR_MODEL=claude-sonnet-5-5

# Canonical origin for Open Graph URLs (e.g. https://rollout.example.com)
NEXT_PUBLIC_SITE_URL=

# Phase 2: MediaPipe hand-control mode (stand-in for sEMG wristband input)
NEXT_PUBLIC_FEATURE_HAND=0
